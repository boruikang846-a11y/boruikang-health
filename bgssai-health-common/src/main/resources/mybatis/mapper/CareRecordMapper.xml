<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.CareRecordMapper">
 <resultMap id="row" type="com.bgssai.health.model.CareRecord" autoMapping="true"><id column="id" property="id"/><result column="is_needs_contact" property="needsContact"/></resultMap>
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,record_type,occurred_at,content,medication_cycle_days,next_visit_date,systolic,diastolic,heart_rate,weight,glucose,is_needs_contact,source_system,external_id</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM care_record WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM care_record <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM care_record <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO care_record (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{recordType},#{occurredAt},#{content},#{medicationCycleDays},#{nextVisitDate},#{systolic},#{diastolic},#{heartRate},#{weight},#{glucose},COALESCE(#{needsContact},0),#{sourceSystem},#{externalId})</insert>
 <update id="updateByExampleSelective">UPDATE care_record <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.recordType != null">record_type=#{row.recordType},</if><if test="row.occurredAt != null">occurred_at=#{row.occurredAt},</if><if test="row.content != null">content=#{row.content},</if><if test="row.medicationCycleDays != null">medication_cycle_days=#{row.medicationCycleDays},</if><if test="row.nextVisitDate != null">next_visit_date=#{row.nextVisitDate},</if><if test="row.systolic != null">systolic=#{row.systolic},</if><if test="row.diastolic != null">diastolic=#{row.diastolic},</if><if test="row.heartRate != null">heart_rate=#{row.heartRate},</if><if test="row.weight != null">weight=#{row.weight},</if><if test="row.glucose != null">glucose=#{row.glucose},</if><if test="row.needsContact != null">is_needs_contact=#{row.needsContact},</if><if test="row.sourceSystem != null">source_system=#{row.sourceSystem},</if><if test="row.externalId != null">external_id=#{row.externalId},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
