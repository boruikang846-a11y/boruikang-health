 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,direction,referral_type,from_org_id,to_org_id,reason,risk_level,initiated_at,sla_due_at,status,accepted_at,arrived_at,feedback_department,feedback_clinician_id,feedback_diagnosis,feedback_disposition,feedback_at,evidence,actor_id,request_key,version</sql>
