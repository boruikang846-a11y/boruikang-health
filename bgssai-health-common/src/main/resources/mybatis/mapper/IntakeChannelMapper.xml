<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.IntakeChannelMapper">
 <resultMap id="row" type="com.bgssai.health.model.IntakeChannel" autoMapping="true"><id column="id" property="id"/><result column="is_active" property="active"/></resultMap>
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,title,source,department,doctor_id,owner_id,token,is_active</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM intake_channel WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM intake_channel <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM intake_channel <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO intake_channel (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{title},#{source},#{department},#{doctorId},#{ownerId},#{token},COALESCE(#{active},1))</insert>
 <update id="updateByExampleSelective">UPDATE intake_channel <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.title != null">title=#{row.title},</if><if test="row.source != null">source=#{row.source},</if><if test="row.department != null">department=#{row.department},</if><if test="row.doctorId != null">doctor_id=#{row.doctorId},</if><if test="row.ownerId != null">owner_id=#{row.ownerId},</if><if test="row.token != null">token=#{row.token},</if><if test="row.active != null">is_active=#{row.active},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
