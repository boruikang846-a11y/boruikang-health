 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,owner_id,report_type,from_date,to_date,summary,action_plan,snapshot_json,delivery_evidence,delivered_at,version</sql>
