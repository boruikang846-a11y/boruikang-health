 <select id="selectByExample" resultType="com.bgssai.health.model.OperationsReport">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM operations_report <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
