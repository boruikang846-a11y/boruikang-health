 <update id="updateByExampleSelective">UPDATE operations_report <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.ownerId != null">owner_id=#{row.ownerId},</if><if test="row.reportType != null">report_type=#{row.reportType},</if><if test="row.fromDate != null">from_date=#{row.fromDate},</if><if test="row.toDate != null">to_date=#{row.toDate},</if><if test="row.summary != null">summary=#{row.summary},</if><if test="row.actionPlan != null">action_plan=#{row.actionPlan},</if><if test="row.snapshotJson != null">snapshot_json=#{row.snapshotJson},</if><if test="row.deliveryEvidence != null">delivery_evidence=#{row.deliveryEvidence},</if><if test="row.deliveredAt != null">delivered_at=#{row.deliveredAt},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
