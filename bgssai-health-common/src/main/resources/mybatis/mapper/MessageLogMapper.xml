<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.MessageLogMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,task_id,channel,template_code,content,sent_at,actor_id,evidence,request_key</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.MessageLog">SELECT <include refid="columns"/> FROM message_log WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.MessageLog">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM message_log <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM message_log <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO message_log (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{taskId},#{channel},#{templateCode},#{content},#{sentAt},#{actorId},#{evidence},#{requestKey})</insert>
 <update id="updateByExampleSelective">UPDATE message_log <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.taskId != null">task_id=#{row.taskId},</if><if test="row.channel != null">channel=#{row.channel},</if><if test="row.templateCode != null">template_code=#{row.templateCode},</if><if test="row.content != null">content=#{row.content},</if><if test="row.sentAt != null">sent_at=#{row.sentAt},</if><if test="row.actorId != null">actor_id=#{row.actorId},</if><if test="row.evidence != null">evidence=#{row.evidence},</if><if test="row.requestKey != null">request_key=#{row.requestKey},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
