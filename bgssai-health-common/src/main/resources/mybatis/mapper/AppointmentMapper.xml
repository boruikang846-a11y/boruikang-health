 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,task_id,invitation_id,referral_id,appointment_type,channel,appointment_at,department,clinician_id,status,reminder_sent_at,arrived_at,is_effective,no_show_reason,outcome,outcome_note,evidence,actor_id,request_key,version</sql>
