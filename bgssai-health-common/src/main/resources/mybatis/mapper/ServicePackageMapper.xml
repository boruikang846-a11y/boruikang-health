<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.ServicePackageMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,code,name,disease,tier,scene,period_days,price_cents,followup_count,assessment_count,review_count,device_note,privilege_note,service_hours,content,red_lines,plan_id,status,version</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.ServicePackage">SELECT <include refid="columns"/> FROM service_package WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.ServicePackage">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM service_package <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM service_package <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO service_package (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{code},#{name},#{disease},#{tier},#{scene},#{periodDays},#{priceCents},COALESCE(#{followupCount},0),COALESCE(#{assessmentCount},0),COALESCE(#{reviewCount},0),#{deviceNote},#{privilegeNote},#{serviceHours},#{content},#{redLines},#{planId},COALESCE(#{status},'DRAFT'),COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE service_package <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.code != null">code=#{row.code},</if><if test="row.name != null">name=#{row.name},</if><if test="row.disease != null">disease=#{row.disease},</if><if test="row.tier != null">tier=#{row.tier},</if><if test="row.scene != null">scene=#{row.scene},</if><if test="row.periodDays != null">period_days=#{row.periodDays},</if><if test="row.priceCents != null">price_cents=#{row.priceCents},</if><if test="row.followupCount != null">followup_count=#{row.followupCount},</if><if test="row.assessmentCount != null">assessment_count=#{row.assessmentCount},</if><if test="row.reviewCount != null">review_count=#{row.reviewCount},</if><if test="row.deviceNote != null">device_note=#{row.deviceNote},</if><if test="row.privilegeNote != null">privilege_note=#{row.privilegeNote},</if><if test="row.serviceHours != null">service_hours=#{row.serviceHours},</if><if test="row.content != null">content=#{row.content},</if><if test="row.redLines != null">red_lines=#{row.redLines},</if><if test="row.planId != null">plan_id=#{row.planId},</if><if test="row.status != null">status=#{row.status},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
