<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.CareMessageMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,task_id,sender_id,sender_role,direction,content</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.CareMessage">SELECT <include refid="columns"/> FROM care_message WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.CareMessage">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM care_message <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM care_message <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO care_message (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{taskId},#{senderId},#{senderRole},#{direction},#{content})</insert>
 <update id="updateByExampleSelective">UPDATE care_message <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.taskId != null">task_id=#{row.taskId},</if><if test="row.senderId != null">sender_id=#{row.senderId},</if><if test="row.senderRole != null">sender_role=#{row.senderRole},</if><if test="row.direction != null">direction=#{row.direction},</if><if test="row.content != null">content=#{row.content},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
