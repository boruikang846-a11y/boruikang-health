<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.PatientMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,account_id,source_system,hospital_patient_id,name,gender,age,phone,department,disease,risk_level,lifecycle,doctor_id,owner_id,channel_id,service_package_id,consent_at,note,version</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.Patient">SELECT <include refid="columns"/> FROM patient WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.Patient">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM patient <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM patient <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO patient (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{accountId},COALESCE(#{sourceSystem},'MANUAL'),#{hospitalPatientId},#{name},#{gender},#{age},#{phone},#{department},#{disease},COALESCE(#{riskLevel},'UNKNOWN'),COALESCE(#{lifecycle},'ENROLLED'),#{doctorId},#{ownerId},#{channelId},#{servicePackageId},#{consentAt},#{note},COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE patient <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.accountId != null">account_id=#{row.accountId},</if><if test="row.name != null">name=#{row.name},</if><if test="row.gender != null">gender=#{row.gender},</if><if test="row.age != null">age=#{row.age},</if><if test="row.phone != null">phone=#{row.phone},</if><if test="row.department != null">department=#{row.department},</if><if test="row.disease != null">disease=#{row.disease},</if><if test="row.riskLevel != null">risk_level=#{row.riskLevel},</if><if test="row.lifecycle != null">lifecycle=#{row.lifecycle},</if><if test="row.doctorId != null">doctor_id=#{row.doctorId},</if><if test="row.ownerId != null">owner_id=#{row.ownerId},</if><if test="row.channelId != null">channel_id=#{row.channelId},</if><if test="row.servicePackageId != null">service_package_id=#{row.servicePackageId},</if><if test="row.consentAt != null">consent_at=#{row.consentAt},</if><if test="row.note != null">note=#{row.note},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
