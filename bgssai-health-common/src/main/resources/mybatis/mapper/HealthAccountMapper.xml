<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.HealthAccountMapper">
 <resultMap id="row" type="com.bgssai.health.model.HealthAccount" autoMapping="true"><id column="id" property="id"/><result column="is_enabled" property="enabled"/></resultMap>
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>, username,password,real_name,role_code,hospital_id,department,current_session_id,is_enabled,wecom_user_id</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM health_account WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="selectedColumns != null and !selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM health_account <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM health_account <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO health_account (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{username},#{password},#{realName},#{roleCode},#{hospitalId},#{department},#{currentSessionId},COALESCE(#{enabled},1),#{wecomUserId})</insert>
 <update id="updateByExampleSelective">UPDATE health_account <set><if test="row.username != null">username=#{row.username},</if><if test="row.password != null">password=#{row.password},</if><if test="row.realName != null">real_name=#{row.realName},</if><if test="row.roleCode != null">role_code=#{row.roleCode},</if><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.department != null">department=#{row.department},</if><if test="row.currentSessionId != null">current_session_id=#{row.currentSessionId},</if><if test="row.enabled != null">is_enabled=#{row.enabled},</if><if test="row.wecomUserId != null">wecom_user_id=#{row.wecomUserId},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
