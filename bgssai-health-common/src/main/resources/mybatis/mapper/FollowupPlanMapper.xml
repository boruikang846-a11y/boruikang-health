<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.FollowupPlanMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,name,disease,entry_scene,description,status,version</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.FollowupPlan">SELECT <include refid="columns"/> FROM followup_plan WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.FollowupPlan">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM followup_plan <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM followup_plan <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO followup_plan (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{name},#{disease},#{entryScene},#{description},COALESCE(#{status},'DRAFT'),COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE followup_plan <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.name != null">name=#{row.name},</if><if test="row.disease != null">disease=#{row.disease},</if><if test="row.entryScene != null">entry_scene=#{row.entryScene},</if><if test="row.description != null">description=#{row.description},</if><if test="row.status != null">status=#{row.status},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
