<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.FollowupPlanNodeMapper">
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,plan_id,seq,stage,offset_days,task_type,title,priority,checklist</sql>
 <select id="selectByPrimaryKey" resultType="com.bgssai.health.model.FollowupPlanNode">SELECT <include refid="columns"/> FROM followup_plan_node WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.bgssai.health.model.FollowupPlanNode">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM followup_plan_node <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM followup_plan_node <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO followup_plan_node (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{planId},#{seq},#{stage},#{offsetDays},#{taskType},#{title},COALESCE(#{priority},'P2'),#{checklist})</insert>
 <update id="updateByExampleSelective">UPDATE followup_plan_node <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.planId != null">plan_id=#{row.planId},</if><if test="row.seq != null">seq=#{row.seq},</if><if test="row.stage != null">stage=#{row.stage},</if><if test="row.offsetDays != null">offset_days=#{row.offsetDays},</if><if test="row.taskType != null">task_type=#{row.taskType},</if><if test="row.title != null">title=#{row.title},</if><if test="row.priority != null">priority=#{row.priority},</if><if test="row.checklist != null">checklist=#{row.checklist},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
