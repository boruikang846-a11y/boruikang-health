<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.health.mapper.JourneyCaseMapper">
 <resultMap id="row" type="com.bgssai.health.model.JourneyCase" autoMapping="true"><id column="id" property="id"/></resultMap>
 <sql id="columns"><include refid="com.bgssai.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,journey_id,kind,status,summary,due_at,owner_id,doctor_id,resolution,receipt_evidence,version</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM journey_case WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM journey_case <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM journey_case <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO journey_case (<include refid="columns"/>) VALUES (<include refid="com.bgssai.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{journeyId},#{kind},#{status},#{summary},#{dueAt},#{ownerId},#{doctorId},#{resolution},#{receiptEvidence},#{version})</insert>
 <update id="updateByExampleSelective">UPDATE journey_case <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.journeyId != null">journey_id=#{row.journeyId},</if><if test="row.kind != null">kind=#{row.kind},</if><if test="row.status != null">status=#{row.status},</if><if test="row.summary != null">summary=#{row.summary},</if><if test="row.dueAt != null">due_at=#{row.dueAt},</if><if test="row.ownerId != null">owner_id=#{row.ownerId},</if><if test="row.doctorId != null">doctor_id=#{row.doctorId},</if><if test="row.resolution != null">resolution=#{row.resolution},</if><if test="row.receiptEvidence != null">receipt_evidence=#{row.receiptEvidence},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.bgssai.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
<select id="selectScopedByExample" resultMap="row">SELECT <include refid="columns"/> FROM journey_case <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include> AND patient_id IN (SELECT id FROM patient <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="patientScope."/></include>) ORDER BY ${example.orderByClause}</select>
<select id="countScopedByExample" resultType="long">SELECT COUNT(id) FROM journey_case <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include> AND patient_id IN (SELECT id FROM patient <include refid="com.bgssai.health.mapper.ExampleSql.where"><property name="prefix" value="patientScope."/></include>)</select>
</mapper>
