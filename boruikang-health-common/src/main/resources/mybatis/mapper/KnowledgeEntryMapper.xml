<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.KnowledgeEntryMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,kind,department,title,content,source,version,status,reviewer_id,reviewed_at,service_days,followup_count</sql>
 <select id="selectByPrimaryKey" resultType="com.boruikang.health.model.KnowledgeEntry">SELECT <include refid="columns"/> FROM knowledge_entry WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.boruikang.health.model.KnowledgeEntry">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM knowledge_entry <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM knowledge_entry <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO knowledge_entry (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{kind},#{department},#{title},#{content},#{source},COALESCE(#{version},1),COALESCE(#{status},'DRAFT'),#{reviewerId},#{reviewedAt},#{serviceDays},#{followupCount})</insert>
 <update id="updateByExampleSelective">UPDATE knowledge_entry <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.kind != null">kind=#{row.kind},</if><if test="row.department != null">department=#{row.department},</if><if test="row.title != null">title=#{row.title},</if><if test="row.content != null">content=#{row.content},</if><if test="row.source != null">source=#{row.source},</if><if test="row.version != null">version=#{row.version},</if><if test="row.status != null">status=#{row.status},</if><if test="row.reviewerId != null">reviewer_id=#{row.reviewerId},</if><if test="row.reviewedAt != null">reviewed_at=#{row.reviewedAt},</if><if test="row.serviceDays != null">service_days=#{row.serviceDays},</if><if test="row.followupCount != null">followup_count=#{row.followupCount},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
