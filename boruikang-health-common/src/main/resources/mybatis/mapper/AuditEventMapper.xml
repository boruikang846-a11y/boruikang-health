<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.AuditEventMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,actor_id,action,resource_id,before_state,after_state,detail</sql>
 <select id="selectByExample" resultType="com.boruikang.health.model.AuditEvent">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM audit_event <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM audit_event <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO audit_event (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{actorId},#{action},#{resourceId},#{beforeState},#{afterState},#{detail})</insert>
</mapper>
