<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.CampaignMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,name,campaign_type,org_id,location,starts_on,ends_on,owner_id,status,target_count,note,version</sql>
 <select id="selectByPrimaryKey" resultType="com.boruikang.health.model.Campaign">SELECT <include refid="columns"/> FROM campaign WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.boruikang.health.model.Campaign">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM campaign <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM campaign <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO campaign (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{name},#{campaignType},#{orgId},#{location},#{startsOn},#{endsOn},#{ownerId},COALESCE(#{status},'PLANNED'),#{targetCount},#{note},COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE campaign <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.name != null">name=#{row.name},</if><if test="row.campaignType != null">campaign_type=#{row.campaignType},</if><if test="row.orgId != null">org_id=#{row.orgId},</if><if test="row.location != null">location=#{row.location},</if><if test="row.startsOn != null">starts_on=#{row.startsOn},</if><if test="row.endsOn != null">ends_on=#{row.endsOn},</if><if test="row.ownerId != null">owner_id=#{row.ownerId},</if><if test="row.status != null">status=#{row.status},</if><if test="row.targetCount != null">target_count=#{row.targetCount},</if><if test="row.note != null">note=#{row.note},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
