<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.IntegrationConfigMapper">
 <resultMap id="row" type="com.boruikang.health.model.IntegrationConfig" autoMapping="true"><id column="id" property="id"/><result column="is_enabled" property="enabled"/></resultMap>
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,provider,endpoint,model_name,secret,is_enabled,app_id,callback_token,aes_key,channel_mode,verify_status,verified_at,last_error</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM integration_config WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM integration_config <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}</select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM integration_config <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO integration_config (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{provider},#{endpoint},#{modelName},#{secret},COALESCE(#{enabled},0),#{appId},#{callbackToken},#{aesKey},COALESCE(#{channelMode},'LIVE'),COALESCE(#{verifyStatus},'UNVERIFIED'),#{verifiedAt},#{lastError})</insert>
 <update id="updateByExampleSelective">UPDATE integration_config <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.provider != null">provider=#{row.provider},</if><if test="row.endpoint != null">endpoint=#{row.endpoint},</if><if test="row.modelName != null">model_name=#{row.modelName},</if><if test="row.secret != null">secret=#{row.secret},</if><if test="row.enabled != null">is_enabled=#{row.enabled},</if><if test="row.appId != null">app_id=#{row.appId},</if><if test="row.callbackToken != null">callback_token=#{row.callbackToken},</if><if test="row.aesKey != null">aes_key=#{row.aesKey},</if><if test="row.channelMode != null">channel_mode=#{row.channelMode},</if><if test="row.verifyStatus != null">verify_status=#{row.verifyStatus},</if><if test="row.verifiedAt != null">verified_at=#{row.verifiedAt},</if><if test="row.lastError != null">last_error=#{row.lastError},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
