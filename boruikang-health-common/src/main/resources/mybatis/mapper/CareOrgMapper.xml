<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.CareOrgMapper">
 <resultMap id="row" type="com.boruikang.health.model.CareOrg" autoMapping="true"><id column="id" property="id"/><result column="is_active" property="active"/></resultMap>
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,name,org_type,parent_id,contact_name,contact_phone,is_active,note</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM care_org WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM care_org <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM care_org <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO care_org (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{name},#{orgType},#{parentId},#{contactName},#{contactPhone},COALESCE(#{active},1),#{note})</insert>
 <update id="updateByExampleSelective">UPDATE care_org <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.name != null">name=#{row.name},</if><if test="row.orgType != null">org_type=#{row.orgType},</if><if test="row.parentId != null">parent_id=#{row.parentId},</if><if test="row.contactName != null">contact_name=#{row.contactName},</if><if test="row.contactPhone != null">contact_phone=#{row.contactPhone},</if><if test="row.active != null">is_active=#{row.active},</if><if test="row.note != null">note=#{row.note},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
