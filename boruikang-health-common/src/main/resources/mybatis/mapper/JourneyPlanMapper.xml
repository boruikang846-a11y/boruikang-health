 <resultMap id="row" type="com.boruikang.health.model.JourneyPlan" autoMapping="true"><id column="id" property="id"/></resultMap>
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,journey_id,revision,status,report_id,report_snapshot,plan_text,nodes_json,template_id,template_version,reviewer_id,reviewed_at,review_note,baseline_at</sql>
 <select id="selectByPrimaryKey" resultMap="row">SELECT <include refid="columns"/> FROM journey_plan WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultMap="row">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM journey_plan <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM journey_plan <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO journey_plan (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{journeyId},#{revision},#{status},#{reportId},#{reportSnapshot},#{planText},#{nodesJson},#{templateId},#{templateVersion},#{reviewerId},#{reviewedAt},#{reviewNote},#{baselineAt})</insert>
 <update id="updateByExampleSelective">UPDATE journey_plan <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.journeyId != null">journey_id=#{row.journeyId},</if><if test="row.revision != null">revision=#{row.revision},</if><if test="row.status != null">status=#{row.status},</if><if test="row.reportId != null">report_id=#{row.reportId},</if><if test="row.reportSnapshot != null">report_snapshot=#{row.reportSnapshot},</if><if test="row.planText != null">plan_text=#{row.planText},</if><if test="row.nodesJson != null">nodes_json=#{row.nodesJson},</if><if test="row.templateId != null">template_id=#{row.templateId},</if><if test="row.templateVersion != null">template_version=#{row.templateVersion},</if><if test="row.reviewerId != null">reviewer_id=#{row.reviewerId},</if><if test="row.reviewedAt != null">reviewed_at=#{row.reviewedAt},</if><if test="row.reviewNote != null">review_note=#{row.reviewNote},</if><if test="row.baselineAt != null">baseline_at=#{row.baselineAt},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
<select id="selectScopedByExample" resultMap="row">SELECT <include refid="columns"/> FROM journey_plan <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include> AND patient_id IN (SELECT id FROM patient <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="patientScope."/></include>) ORDER BY ${example.orderByClause}</select>
<select id="countScopedByExample" resultType="long">SELECT COUNT(id) FROM journey_plan <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include> AND patient_id IN (SELECT id FROM patient <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="patientScope."/></include>)</select>
