<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.SlaConfigMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,risk_level,first_contact_hours,booking_days,arrival_days,lost_after_attempts,note,version</sql>
 <select id="selectByPrimaryKey" resultType="com.boruikang.health.model.SlaConfig">SELECT <include refid="columns"/> FROM sla_config WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.boruikang.health.model.SlaConfig">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM sla_config <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM sla_config <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO sla_config (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{riskLevel},#{firstContactHours},#{bookingDays},#{arrivalDays},COALESCE(#{lostAfterAttempts},3),#{note},COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE sla_config <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.riskLevel != null">risk_level=#{row.riskLevel},</if><if test="row.firstContactHours != null">first_contact_hours=#{row.firstContactHours},</if><if test="row.bookingDays != null">booking_days=#{row.bookingDays},</if><if test="row.arrivalDays != null">arrival_days=#{row.arrivalDays},</if><if test="row.lostAfterAttempts != null">lost_after_attempts=#{row.lostAfterAttempts},</if><if test="row.note != null">note=#{row.note},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
