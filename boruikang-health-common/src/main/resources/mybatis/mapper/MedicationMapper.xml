<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.MedicationMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,drug_name,dosage,frequency,start_date,end_date,status,source,adherence,note,version</sql>
 <select id="selectByPrimaryKey" resultType="com.boruikang.health.model.Medication">SELECT <include refid="columns"/> FROM medication WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.boruikang.health.model.Medication">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM medication <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM medication <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO medication (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{drugName},#{dosage},#{frequency},#{startDate},#{endDate},COALESCE(#{status},'ACTIVE'),COALESCE(#{source},'STAFF'),COALESCE(#{adherence},'UNKNOWN'),#{note},COALESCE(#{version},0))</insert>
 <update id="updateByExampleSelective">UPDATE medication <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.drugName != null">drug_name=#{row.drugName},</if><if test="row.dosage != null">dosage=#{row.dosage},</if><if test="row.frequency != null">frequency=#{row.frequency},</if><if test="row.startDate != null">start_date=#{row.startDate},</if><if test="row.endDate != null">end_date=#{row.endDate},</if><if test="row.status != null">status=#{row.status},</if><if test="row.source != null">source=#{row.source},</if><if test="row.adherence != null">adherence=#{row.adherence},</if><if test="row.note != null">note=#{row.note},</if><if test="row.version != null">version=#{row.version},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
