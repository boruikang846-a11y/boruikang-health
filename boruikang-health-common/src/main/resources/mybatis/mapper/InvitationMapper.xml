<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boruikang.health.mapper.InvitationMapper">
 <sql id="columns"><include refid="com.boruikang.health.mapper.ExampleSql.auditColumns"/>,hospital_id,patient_id,screening_id,campaign_id,round,invited_at,method,result,planned_visit_mode,summary,next_invite_at,actor_id,evidence,request_key</sql>
 <select id="selectByPrimaryKey" resultType="com.boruikang.health.model.Invitation">SELECT <include refid="columns"/> FROM invitation WHERE id=#{id} AND del_flag=0</select>
 <select id="selectByExample" resultType="com.boruikang.health.model.Invitation">SELECT <choose><when test="!selectedColumns.isEmpty()"><foreach collection="selectedColumns" item="col" separator=",">${col}</foreach></when><otherwise><include refid="columns"/></otherwise></choose> FROM invitation <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include> ORDER BY ${orderByClause}<if test="forUpdate"> FOR UPDATE</if></select>
 <select id="countByExample" resultType="long">SELECT COUNT(id) FROM invitation <include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value=""/></include></select>
 <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">INSERT INTO invitation (<include refid="columns"/>) VALUES (<include refid="com.boruikang.health.mapper.ExampleSql.auditValues"/>,#{hospitalId},#{patientId},#{screeningId},#{campaignId},COALESCE(#{round},1),#{invitedAt},#{method},#{result},#{plannedVisitMode},#{summary},#{nextInviteAt},#{actorId},#{evidence},#{requestKey})</insert>
 <update id="updateByExampleSelective">UPDATE invitation <set><if test="row.hospitalId != null">hospital_id=#{row.hospitalId},</if><if test="row.patientId != null">patient_id=#{row.patientId},</if><if test="row.screeningId != null">screening_id=#{row.screeningId},</if><if test="row.campaignId != null">campaign_id=#{row.campaignId},</if><if test="row.round != null">round=#{row.round},</if><if test="row.invitedAt != null">invited_at=#{row.invitedAt},</if><if test="row.method != null">method=#{row.method},</if><if test="row.result != null">result=#{row.result},</if><if test="row.plannedVisitMode != null">planned_visit_mode=#{row.plannedVisitMode},</if><if test="row.summary != null">summary=#{row.summary},</if><if test="row.nextInviteAt != null">next_invite_at=#{row.nextInviteAt},</if><if test="row.actorId != null">actor_id=#{row.actorId},</if><if test="row.evidence != null">evidence=#{row.evidence},</if><if test="row.requestKey != null">request_key=#{row.requestKey},</if><include refid="com.boruikang.health.mapper.ExampleSql.auditUpdate"/></set><include refid="com.boruikang.health.mapper.ExampleSql.where"><property name="prefix" value="example."/></include></update>
</mapper>
